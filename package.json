{
  "name": "cyberpunk-clone",
  "version": "2.0.0",
  "description": "Skills dashboard: one offline HTML file that reads the assessment workbook data/skills-data.xlsx",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/screenshots.mjs",
    "build:html": "vite build",
    "serve": "node scripts/serve.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "data": "python3 scripts/generate_mock_data.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thevaultboy11/cyberpunk-clone.git"
  },
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
